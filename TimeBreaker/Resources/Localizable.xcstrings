    "settings.breaks.footnote" : {
      "comment" : "Explains scheduling rules below the break settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work time excludes breaks and pauses. When both breaks are due at once, only the long break appears. Changes to a break in progress apply from the next break."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作时间不包括休息和暂停时间。两种休息同时到期时，只显示长休息。对进行中休息的更改将从下一次休息开始生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作時間不包括休息和暫停時間。兩種休息同時到期時，只會顯示長休息。對進行中休息的變更將從下一次休息開始生效。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作業時間には休憩と一時停止の時間は含まれません。両方の休憩が同時に来た場合は、長い休憩だけが表示されます。進行中の休憩への変更は、次の休憩から適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 시간에는 휴식 및 일시 정지 시간이 포함되지 않습니다. 두 휴식이 동시에 예정되면 긴 휴식만 표시됩니다. 진행 중인 휴식에 대한 변경 사항은 다음 휴식부터 적용됩니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo de trabajo no incluye descansos ni pausas. Si ambos descansos coinciden, solo se muestra el largo. Los cambios en un descanso en curso se aplican a partir del siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps de travail exclut les pauses et les suspensions. Si les deux pauses arrivent en même temps, seule la pause longue s’affiche. Les modifications d’une pause en cours s’appliquent à partir de la suivante."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo de trabalho exclui pausas e suspensões. Se ambas as pausas coincidirem, só é apresentada a pausa longa. As alterações a uma pausa em curso aplicam-se a partir da seguinte."
          }
        }
      }
    },
