    "settings.appearance.transparency.help" : {
      "comment" : "Explains the transparency scale.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At 0, the background is fully opaque. Text and buttons always stay opaque."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设为 0 时背景完全不透明。文字和按钮始终保持不透明。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設為 0 時背景完全不透明。文字和按鈕始終保持不透明。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0にすると背景は完全に不透明になります。テキストとボタンは常に不透明のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0이면 배경이 완전히 불투명합니다. 텍스트와 버튼은 항상 불투명하게 유지됩니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con 0, el fondo es totalmente opaco. El texto y los botones siempre son opacos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À 0, l’arrière-plan est entièrement opaque. Le texte et les boutons restent toujours opaques."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com 0, o fundo é totalmente opaco. O texto e os botões permanecem sempre opacos."
          }
        }
      }
    },
