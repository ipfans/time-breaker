    "settings.breaks.allowSkip.help" : {
      "comment" : "Explains that disabling Skip does not disable Pause or Quit.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, the Skip button is hidden. Pause and Quit remain available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后将隐藏“跳过”按钮。“暂停”和“退出”仍然可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後會隱藏「略過」按鈕。「暫停」和「結束」仍然可用。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると「スキップ」ボタンが非表示になります。「一時停止」と「終了」は引き続き使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 건너뛰기 버튼이 숨겨집니다. 일시 정지와 종료는 계속 사용할 수 있습니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se desactiva, se oculta el botón Omitir. Pausar y Salir siguen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est désactivée, le bouton Passer est masqué. Suspendre et Quitter restent disponibles."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando desativado, o botão Saltar fica oculto. Suspender e Sair continuam disponíveis."
          }
        }
      }
    },
