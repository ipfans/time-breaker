    "layout.center.help" : {
      "comment" : "Describes the Center layout.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the image at its original size. Larger images are cropped."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以原始大小显示图片，较大的图片会被裁剪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
