    "import.error.animated" : {
      "comment" : "Import error.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animated images aren’t supported. Choose a still image."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持动态图片。请选取静态图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援動態圖片。請選擇靜態圖片。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アニメーションイメージには対応していません。静止画を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애니메이션 이미지는 지원되지 않습니다. 정지 이미지를 선택하세요."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se admiten imágenes animadas. Elige una imagen fija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images animées ne sont pas prises en charge. Choisissez une image fixe."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens animadas não são suportadas. Escolha uma imagem estática."
          }
        }
      }
    },
    "import.error.fileTooLarge" : {
      "comment" : "Import error. %@ is a formatted file size such as “100 MB”.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file is too large. Choose a file smaller than %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件过大。请选取小于 %@ 的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案過大。請選擇小於 %@ 的檔案。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルが大きすぎます。%@未満のファイルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일이 너무 큽니다. %@보다 작은 파일을 선택하세요."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo es demasiado grande. Elige uno de menos de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est trop volumineux. Choisissez un fichier de moins de %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ficheiro é demasiado grande. Escolha um ficheiro com menos de %@."
          }
        }
      }
    },
    "import.error.saveFailed" : {
      "comment" : "Import error.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The image couldn’t be saved. Try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法存储图片，请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存圖片，請再試一次。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イメージを保存できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지를 저장할 수 없습니다. 다시 시도하세요."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar la imagen. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer l’image. Réessayez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível guardar a imagem. Tente novamente."
          }
        }
      }
    },
    "import.error.tooLarge" : {
      "comment" : "Import error. %1$@ is the maximum pixels per side and %2$@ the maximum megapixels, as formatted numbers.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The image is too large. Choose one up to %1$@ pixels on each side and %2$@ megapixels in total."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图片过大。请选取每边不超过 %1$@ 像素、总计不超过 %2$@ 百万像素的图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖片過大。請選擇每邊不超過 %1$@ 像素、總計不超過 %2$@ 百萬像素的圖片。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イメージが大きすぎます。各辺%1$@ピクセル以下、合計%2$@メガピクセル以下のイメージを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지가 너무 큽니다. 각 변이 %1$@픽셀 이하이고 전체 %2$@메가픽셀 이하인 이미지를 선택하세요."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen es demasiado grande. Elige una de hasta %1$@ píxeles por lado y %2$@ megapíxeles en total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image est trop grande. Choisissez-en une de %1$@ pixels maximum par côté et de %2$@ mégapixels au total."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A imagem é demasiado grande. Escolha uma com até %1$@ píxeis de lado e %2$@ megapíxeis no total."
          }
        }
      }
    },
    "import.error.unreadable" : {
      "comment" : "Import error.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The image couldn’t be read. The file may be damaged."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取图片，文件可能已损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取圖片，檔案可能已損毀。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イメージを読み込めませんでした。ファイルが破損している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지를 읽을 수 없습니다. 파일이 손상되었을 수 있습니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer la imagen. Es posible que el archivo esté dañado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire l’image. Le fichier est peut-être endommagé."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a imagem. O ficheiro pode estar danificado."
          }
        }
      }
    },
    "import.error.unsupported" : {
      "comment" : "Import error.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file isn’t a supported image. Choose a PNG, JPEG, or HEIC file."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件不是受支持的图片。请选取 PNG、JPEG 或 HEIC 文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案不是支援的圖片。請選擇 PNG、JPEG 或 HEIC 檔案。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは対応しているイメージではありません。PNG、JPEG、またはHEICファイルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원되는 이미지 파일이 아닙니다. PNG, JPEG 또는 HEIC 파일을 선택하세요."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo no es una imagen compatible. Elige un archivo PNG, JPEG o HEIC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier n’est pas une image prise en charge. Choisissez un fichier PNG, JPEG ou HEIC."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ficheiro não é uma imagem suportada. Escolha um ficheiro PNG, JPEG ou HEIC."
          }
        }
      }
    },
